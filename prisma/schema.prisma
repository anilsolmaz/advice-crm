// ============================================================
// Advice CRM — Prisma Schema (V2 Full Architecture)
// Language: English (identifiers, enums, logic)
// UI Language: Turkish (handled in Next.js layer)
// DB: PostgreSQL
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  ADMIN
  ADVISOR
  ACCOUNTING
  STUDENT
}

enum LeadStatus {
  INTERESTED
  CONSIDERING_NEXT_YEAR
  UNINTERESTED
  NOT_CONSIDERING
  REGISTERED
}

enum Program {
  WORK_AND_TRAVEL
  ACADEMY
  LANGUAGE_SCHOOL
  SUMMER_CAMP
  VISA_CONSULTING
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REVISION_REQUESTED
}

enum ApprovalEntityType {
  STUDENT_PROFILE
  PASSPORT_DETAILS
  EMERGENCY_CONTACT
  WAT_DETAIL
  ACADEMY_DETAIL
  LANGUAGE_DETAIL
  SUMMER_CAMP_DETAIL
  VISA_DETAIL
  DOCUMENT
  EXAM_SCORE
}

enum DocumentType {
  PASSPORT
  NATIONAL_ID
  TRANSCRIPT
  DIPLOMA
  LANGUAGE_SCORE_REPORT
  BANK_STATEMENT
  PHOTO
  VISA_APPLICATION_FORM
  SPONSOR_LETTER
  HEALTH_INSURANCE
  REFERENCE_LETTER
  DS_2019
  CV
  CRIMINAL_RECORD
  CONTRACT
  SEVIS_RECEIPT
  JOB_OFFER
  STUDENT_CERTIFICATE
  DS_160_CONFIRMATION
  PAYMENT_RECEIPT
  OTHER
}

enum VerificationStatus {
  PENDING
  APPROVED
  REVISION_REQUESTED
}

enum Currency {
  USD
  EUR
  TRY
  GBP
}

enum PaymentStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum LeadSource {
  WEBSITE
  SOCIAL_MEDIA
  REFERRAL
  FAIR
  PHONE
  WALK_IN
  OTHER
}

enum AcademicLevel {
  HIGH_SCHOOL
  UNDERGRADUATE
  MASTERS
  PHD
}

enum VisaType {
  TOURIST
  STUDENT
  WORK
  TRANSIT
}

// ============================================================
// CORE USER, AUTH & DYNAMIC ROLES
// ============================================================

/// Mirrors Supabase auth.users. id = auth.uid() UUID.
model User {
  id           String   @id @db.Uuid
  email        String   @unique
  fullName     String
  phone        String?
  avatarUrl    String?
  passwordHash String?
  role         Role     @default(STUDENT)
  customRoleId String?  @db.Uuid
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  customRole        CustomRole?        @relation(fields: [customRoleId], references: [id])
  advisorProfile    AdvisorProfile?
  studentProfile    Student?
  leadsAsAdvisor    Lead[]             @relation("AdvisorLeads")
  leadCallLogs      LeadCallLog[]      @relation("CallLogAdvisor")
  studentsAsAdvisor Student[]          @relation("AdvisorStudents")
  advisorNotes      AdvisorNote[]      @relation("NoteAuthor")
  reviewedApprovals PendingApproval[]  @relation("ApprovalReviewer")
  jobAssignments    WatJobAssignment[] @relation("JobAssignedBy")
  accountingEntries AccountingEntry[]  @relation("AccountingAdvisor")
  notifications     Notification[]     @relation("UserNotifications")

  @@map("users")
}

model CustomRole {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  slug        String   @unique
  description String?
  baseRole    Role     @default(ADVISOR)
  permissions Json     @default("{}")
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]

  @@map("custom_roles")
}

model AdvisorProfile {
  id                   String    @id @default(uuid()) @db.Uuid
  userId               String    @unique @db.Uuid
  department           String?
  bio                  String?
  allowedPrograms      Program[] @default([WORK_AND_TRAVEL, ACADEMY, LANGUAGE_SCHOOL, SUMMER_CAMP, VISA_CONSULTING])
  canManageApprovals   Boolean   @default(true)
  canManageMarketing   Boolean   @default(true)
  canExportData        Boolean   @default(false)
  canViewAllLeads      Boolean   @default(true)
  canManageAccounting  Boolean   @default(false)
  canManageJobPool     Boolean   @default(true)
  canManagePartnerPool Boolean   @default(true)
  monthlyTargetRegistrations Int @default(10)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("advisor_profiles")
}

// ============================================================
// LEADS & CALL FOLLOW-UP TRACKING
// ============================================================

model Lead {
  id              String     @id @default(uuid()) @db.Uuid
  fullName        String
  email           String
  phone           String
  source          LeadSource @default(WEBSITE)
  status          LeadStatus @default(INTERESTED)
  program         Program
  sponsor         String?
  city            String?
  visaStatus      String?
  notes           String?
  advisorId       String?    @db.Uuid
  followUpAt      DateTime?
  lastContactedAt DateTime?
  lastCallOutcome String?
  callCount       Int        @default(0)
  convertedAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  advisor  User?         @relation("AdvisorLeads", fields: [advisorId], references: [id])
  student  Student?
  callLogs LeadCallLog[]

  @@index([status])
  @@index([advisorId])
  @@index([program])
  @@index([email])
  @@index([phone])
  @@index([followUpAt])
  @@index([createdAt])
  @@map("leads")
}

model LeadCallLog {
  id             String    @id @default(uuid()) @db.Uuid
  leadId         String    @db.Uuid
  advisorId      String    @db.Uuid
  outcome        String
  notes          String?
  nextFollowUpAt DateTime?
  createdAt      DateTime  @default(now())

  lead    Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  advisor User @relation("CallLogAdvisor", fields: [advisorId], references: [id])

  @@index([leadId, createdAt])
  @@index([advisorId])
  @@map("lead_call_logs")
}

// ============================================================
// STUDENT CORE
// ============================================================

model Student {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @unique @db.Uuid
  leadId          String?  @unique @db.Uuid
  advisorId       String?  @db.Uuid
  program         Program
  groupName       String?
  summerBookingId String?  @db.Uuid
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  lead          Lead?          @relation(fields: [leadId], references: [id])
  advisor       User?          @relation("AdvisorStudents", fields: [advisorId], references: [id])
  summerBooking SummerBooking? @relation(fields: [summerBookingId], references: [id])

  profile              StudentProfile?
  watDetail            WatDetail?
  academyDetail        AcademyDetail?
  languageDetail       LanguageDetail?
  summerCampDetail     SummerCampDetail?
  visaDetail           VisaDetail?
  documents            Document[]
  payments             Payment[]
  advisorNotes         AdvisorNote[]
  pendingApprovals     PendingApproval[]
  watJobAssignments    WatJobAssignment[]
  academicApplications AcademicApplication[]
  accountingEntries    AccountingEntry[]

  @@index([advisorId])
  @@index([program])
  @@index([groupName])
  @@index([summerBookingId])
  @@index([isActive])
  @@index([createdAt])
  @@map("students")
}

model StudentProfile {
  id        String   @id @default(uuid()) @db.Uuid
  studentId String   @unique @db.Uuid
  updatedAt DateTime @updatedAt

  // Personal Info
  nationalId    String
  dateOfBirth   DateTime
  placeOfBirth  String
  nationality   String    @default("TR")
  gender        String?
  maritalStatus String?
  motherName    String?
  fatherName    String?

  // Contact
  addressLine1 String?
  addressLine2 String?
  city         String?
  district     String?
  postalCode   String?
  country      String  @default("TR")

  // Emergency Contact / Guardian
  emergencyContactName         String?
  emergencyContactRelationship String?
  emergencyContactPhone        String?

  // Passport Details
  passportNumber    String?
  passportIssueDate DateTime?
  passportExpiry    DateTime?
  passportCountry   String?
  passportDeadline  DateTime?

  // Academic Background & Work Experience
  highSchoolName String?
  highSchoolGpa  Decimal?       @db.Decimal(4, 2)
  universityName String?
  universityGpa  Decimal?       @db.Decimal(4, 2)
  academicLevel  AcademicLevel?
  fieldOfStudy   String?
  workExperience Json?
  preferences    Json?

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("student_profiles")
}

// ============================================================
// PROGRAM DETAILS
// ============================================================

model WatDetail {
  id        String   @id @default(uuid()) @db.Uuid
  studentId String   @unique @db.Uuid
  updatedAt DateTime @updatedAt

  sponsorName             String?
  sponsorDsNumber         String?
  jobTitle                String?
  employerName            String?
  employerState           String?
  jobStartDate            DateTime?
  jobEndDate              DateTime?
  usArrivalDate           DateTime?
  usDepartureDate         DateTime?
  visaInterviewDate       DateTime?
  visaDeadline            DateTime?
  passportDeadline        DateTime?
  visaApproved            Boolean   @default(false)
  sevisId                 String?
  insurancePolicyNo       String?
  insuranceProvider       String?
  insuranceExpiry         DateTime?
  currentStage            String    @default("PRE_REGISTRATION")
  ds160Status             String    @default("NOT_STARTED")
  ds160ConfirmationNo     String?
  ds160Data               Json?
  accommodationSold       Boolean   @default(false)
  accommodationCommission Decimal?  @db.Decimal(12, 2)
  notes                   String?

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("wat_details")
}

model AcademyDetail {
  id        String   @id @default(uuid()) @db.Uuid
  studentId String   @unique @db.Uuid
  updatedAt DateTime @updatedAt

  targetCountry    String?
  targetUniversity String?
  targetProgram    String?
  academicLevel    AcademicLevel?
  intakeYear       Int?
  intakeSeason     String?

  highSchoolGpa    Decimal? @db.Decimal(4, 2)
  highSchoolSystem String?
  universityGpa    Decimal? @db.Decimal(4, 2)

  // IELTS
  ieltsOverall    Decimal?  @db.Decimal(3, 1)
  ieltsListening  Decimal?  @db.Decimal(3, 1)
  ieltsReading    Decimal?  @db.Decimal(3, 1)
  ieltsWriting    Decimal?  @db.Decimal(3, 1)
  ieltsSpeaking   Decimal?  @db.Decimal(3, 1)
  ieltsTestDate   DateTime?
  ieltsExpiryDate DateTime?

  // TOEFL iBT
  toeflTotal      Int?
  toeflReading    Int?
  toeflListening  Int?
  toeflSpeaking   Int?
  toeflWriting    Int?
  toeflTestDate   DateTime?
  toeflExpiryDate DateTime?

  // Other tests
  duolingoScore Int?
  satScore      Int?
  greScore      Int?
  gmatScore     Int?

  applicationStatus  String?
  leadStage          String?  @default("SHORTLISTING")
  offerLetterUrl     String?
  shortlistedSchools Json?
  valueAddedServices Json?
  notes              String?

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("academy_details")
}

model LanguageDetail {
  id        String   @id @default(uuid()) @db.Uuid
  studentId String   @unique @db.Uuid
  updatedAt DateTime @updatedAt

  targetCountry        String?
  targetCity           String?
  schoolName           String?
  partnerSchoolId      String?   @db.Uuid
  courseType           String?
  startDate            DateTime?
  endDate              DateTime?
  weeksDuration        Int?
  accommodationType    String?
  currentLanguageLevel String?

  // Section 6: Language School Stages
  agreementsDone           Boolean   @default(false)
  agreementsDate           DateTime?
  agreementsDocUrl         String?
  agreementsSignedDone     Boolean   @default(false)
  agreementsSignedDate     DateTime?
  agreementsSignedDocUrl   String?
  grossInvoiceDone         Boolean   @default(false)
  grossInvoiceDate         DateTime?
  grossInvoiceAmount       Decimal?  @db.Decimal(12, 2)
  grossInvoiceDocUrl       String?
  netInvoiceDone           Boolean   @default(false)
  netInvoiceDate           DateTime?
  netInvoiceAmount         Decimal?  @db.Decimal(12, 2)
  netInvoiceDocUrl         String?
  letterOfAcceptanceDone   Boolean   @default(false)
  letterOfAcceptanceDate   DateTime?
  letterOfAcceptanceDocUrl String?

  notes String?

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("language_details")
}

model SummerCampDetail {
  id        String   @id @default(uuid()) @db.Uuid
  studentId String   @unique @db.Uuid
  updatedAt DateTime @updatedAt

  targetCountry       String?
  campName            String?
  campProvider        String?
  programType         String?
  startDate           DateTime?
  endDate             DateTime?
  ageGroup            String?
  guardianName        String?
  guardianPhone       String?
  guardianEmail       String?
  ukviLink            String?
  visaAppointmentDate DateTime?
  visaStatus          String?
  flightArranged      Boolean   @default(false)
  airportTransfer     Boolean   @default(false)
  notes               String?

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("summer_camp_details")
}

model VisaDetail {
  id        String   @id @default(uuid()) @db.Uuid
  studentId String   @unique @db.Uuid
  updatedAt DateTime @updatedAt

  visaType              VisaType
  destinationCountry    String
  targetConsulate       String?
  ukviLink              String?
  applicationDate       DateTime?
  appointmentDate       DateTime?
  visaDeadline          DateTime?
  decisionDate          DateTime?
  decisionStatus        String?
  rejectionReason       String?
  reapplicationPlanned  Boolean   @default(false)
  travelInsuranceExpiry DateTime?
  itineraryReady        Boolean   @default(false)
  notes                 String?

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("visa_details")
}

// ============================================================
// SECTION 4: WORK AND TRAVEL JOB POOL & STUDENT LINK ASSIGNMENTS
// ============================================================

model WatJob {
  id                   String   @id @default(uuid()) @db.Uuid
  sponsor              String   // AWA, UWT, IEE, Life Adventures, Diğer
  program              String   @default("Work and Travel")
  jobCategory          String   // Lifeguard, Hospitality, Amusement Park, Food & Beverage, Retail, Resort, Other
  jobTitle             String   // Job
  placementType        String   @default("Full Placement") // Self, Full Placement, Direct
  location             String   // Şehir / Eyalet
  state                String?  // Eyalet kısaltması (VA, OH, FL...)
  arrivalAirport       String?
  hourlyWage           Decimal  @db.Decimal(8, 2)
  avgWorkingHours      Int      @default(35)
  accommodationCost    Decimal? @db.Decimal(8, 2)
  accommodationDeposit Decimal? @db.Decimal(8, 2)
  food                 String?  // Var/Yok veya $
  transportation       String?
  workApparel          String?
  position             String?
  genderPreference     String   @default("Males and Females") // Females Only, Males Only, Males and Females
  jobStartDate         DateTime
  jobEndDate           DateTime
  earlyLeaveInfo       String?  // Var/Yok veya tarih
  numPlacements        Int      @default(1) // Kontenjan
  filledPlacements     Int      @default(0)
  bonus                String?
  additionalInfo       String?
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  assignments WatJobAssignment[]

  @@index([sponsor])
  @@index([jobCategory])
  @@index([isActive])
  @@map("wat_jobs")
}

model WatJobAssignment {
  id           String    @id @default(uuid()) @db.Uuid
  jobId        String    @db.Uuid
  studentId    String    @db.Uuid
  assignedById String    @db.Uuid
  shareToken   String    @unique
  status       String    @default("SENT") // SENT, VIEWED, ACCEPTED, DECLINED
  studentNote  String?
  respondedAt  DateTime?
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  job        WatJob  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  student    Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  assignedBy User    @relation("JobAssignedBy", fields: [assignedById], references: [id])

  @@index([jobId])
  @@index([studentId])
  @@index([shareToken])
  @@map("wat_job_assignments")
}

// ============================================================
// SECTION 6: PARTNER SCHOOL POOL & ACADEMIC APPLICATIONS
// ============================================================

model PartnerSchool {
  id              String   @id @default(uuid()) @db.Uuid
  name            String
  country         String
  city            String?
  programType     Program  @default(ACADEMY)
  programsOffered String[] @default([])
  quota           Int?
  commissionRate  Decimal? @db.Decimal(5, 2) // Yüzde (%)
  commissionFixed Decimal? @db.Decimal(12, 2) // Sabit tutar
  currency        Currency @default(EUR)
  contactEmail    String?
  website         String?
  notes           String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  applications      AcademicApplication[]
  accountingEntries AccountingEntry[]

  @@index([country])
  @@index([programType])
  @@map("partner_schools")
}

model AcademicApplication {
  id                  String    @id @default(uuid()) @db.Uuid
  appCode             String    @unique // Örn: APP-2026-001
  studentId           String    @db.Uuid
  partnerSchoolId     String?   @db.Uuid
  institutionName     String
  country             String
  courseName          String
  degree              String    // B.Sc., M.Sc., MBA, PhD, Foundation, Language Course
  intake              String    // Fall 2026, Spring 2027 vb.
  priority            Int       @default(1) // Priority 1, Priority 2
  status              String    @default("PREPARING") // PREPARING, SENT_TO_INSTITUTION, CONDITIONAL_OFFER, UNCONDITIONAL_OFFER, APPLICATION_DROPPED, VISA_APPLIED, ENROLLED
  applicationDeadline DateTime?
  visaDeadline        DateTime?
  notes               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  student       Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  partnerSchool PartnerSchool? @relation(fields: [partnerSchoolId], references: [id])

  @@index([studentId])
  @@index([status])
  @@index([applicationDeadline])
  @@map("academic_applications")
}

// ============================================================
// SECTION 7: SUMMER SCHOOL BOOKING & ALLOCATION
// ============================================================

model SummerAllocation {
  id              String    @id @default(uuid()) @db.Uuid
  country         String
  centerName      String
  nights          Int       @default(14)
  startDate       DateTime
  endDate         DateTime?
  totalQuota      Int       @default(20)
  usedQuota       Int       @default(0)
  pricePerStudent Decimal?  @db.Decimal(12, 2)
  currency        Currency  @default(GBP)
  notes           String?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  bookings SummerBooking[]

  @@map("summer_allocations")
}

model SummerBooking {
  id               String    @id @default(uuid()) @db.Uuid
  bookingCode      String    @unique // Örn: BK-2026-001
  groupName        String?
  allocationId     String?   @db.Uuid
  country          String
  centerName       String
  nights           Int
  startDate        DateTime
  participantCount Int       @default(1)
  termsAccepted    Boolean   @default(true)
  airportTransfers Json?     // Varış/Dönüş transfer detayları
  extraServices    Json?     // Ekstra geziler, sigorta, yemek paketleri
  totalAmount      Decimal?  @db.Decimal(12, 2)
  currency         Currency  @default(GBP)
  summaryNotes     String?
  status           String    @default("CONFIRMED") // DRAFT, CONFIRMED, COMPLETED, CANCELLED
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  allocation SummerAllocation? @relation(fields: [allocationId], references: [id])
  students   Student[]

  @@map("summer_bookings")
}

// ============================================================
// SECTION 8: ACCOUNTING LEDGER & COMMISSIONS
// ============================================================

model AccountingEntry {
  id              String    @id @default(uuid()) @db.Uuid
  type            String    // INCOME (Alınan), EXPENSE (Verilen/Gider), COMMISSION (Komisyon)
  category        String    // TUITION, ACCOMMODATION_COMMISSION, SCHOOL_COMMISSION, VISA_FEE, FLIGHT, REFUND, OTHER
  studentId       String?   @db.Uuid
  partnerSchoolId String?   @db.Uuid
  advisorId       String?   @db.Uuid
  description     String
  amount          Decimal   @db.Decimal(12, 2)
  currency        Currency  @default(USD)
  paymentMethod   String?   @default("BANK_TRANSFER") // BANK_TRANSFER, CREDIT_CARD, CASH, OTHER
  weeksSold       Int?      // Okul-hafta satış raporu için
  grossAmount     Decimal?  @db.Decimal(12, 2)
  netAmount       Decimal?  @db.Decimal(12, 2)
  transactionDate DateTime  @default(now())
  dueDate         DateTime?
  isPaid          Boolean   @default(true)
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  student       Student?       @relation(fields: [studentId], references: [id], onDelete: SetNull)
  partnerSchool PartnerSchool? @relation(fields: [partnerSchoolId], references: [id], onDelete: SetNull)
  advisor       User?          @relation("AccountingAdvisor", fields: [advisorId], references: [id])

  @@index([type])
  @@index([studentId])
  @@index([partnerSchoolId])
  @@index([transactionDate])
  @@map("accounting_entries")
}

// ============================================================
// APPROVAL WORKFLOW (Draft / Staging table)
// ============================================================

model PendingApproval {
  id              String             @id @default(uuid()) @db.Uuid
  studentId       String             @db.Uuid
  entityType      ApprovalEntityType
  entityId        String?            @db.Uuid
  oldData         Json?
  newData         Json
  status          ApprovalStatus     @default(PENDING)
  rejectionReason String?
  reviewedById    String?            @db.Uuid
  reviewedAt      DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  student    Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  reviewedBy User?   @relation("ApprovalReviewer", fields: [reviewedById], references: [id])

  @@index([studentId, status])
  @@index([status])
  @@map("pending_approvals")
}

// ============================================================
// DOCUMENTS
// ============================================================

model Document {
  id                 String             @id @default(uuid()) @db.Uuid
  studentId          String             @db.Uuid
  type               DocumentType
  fileName           String
  fileUrl            String
  fileSizeBytes      Int?
  mimeType           String?
  verificationStatus VerificationStatus @default(PENDING)
  rejectionReason    String?
  uploadedByStudent  Boolean            @default(false)
  expiryDate         DateTime?
  notes              String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, type])
  @@index([verificationStatus])
  @@map("documents")
}

// ============================================================
// PAYMENTS & INSTALLMENTS
// ============================================================

model Payment {
  id          String        @id @default(uuid()) @db.Uuid
  studentId   String        @db.Uuid
  description String
  totalAmount Decimal       @db.Decimal(12, 2)
  expenseAmount Decimal     @default(0) @db.Decimal(12, 2)
  currency    Currency      @default(TRY)
  status      PaymentStatus @default(PENDING)
  dueDate     DateTime?
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  student      Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  installments Installment[]

  @@index([studentId, status])
  @@map("payments")
}

model Installment {
  id            String    @id @default(uuid()) @db.Uuid
  paymentId     String    @db.Uuid
  sequence      Int
  amount        Decimal   @db.Decimal(12, 2)
  currency      Currency  @default(TRY)
  dueDate       DateTime
  isPaid        Boolean   @default(false)
  paidAt        DateTime?
  paidAmount    Decimal?  @db.Decimal(12, 2)
  paymentMethod String?   @default("BANK_TRANSFER")
  receiptUrl    String?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([dueDate, isPaid])
  @@map("installments")
}

// ============================================================
// SECTION 9: TEAM CONVERSATION (@MENTION) & NOTIFICATIONS
// ============================================================

model AdvisorNote {
  id               String   @id @default(uuid()) @db.Uuid
  studentId        String   @db.Uuid
  authorId         String   @db.Uuid
  note             String
  mentionedUserIds String[] @default([])
  isPinned         Boolean  @default(false)
  createdAt        DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  author  User    @relation("NoteAuthor", fields: [authorId], references: [id])

  @@index([studentId])
  @@index([authorId])
  @@index([studentId, createdAt])
  @@map("advisor_notes")
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  type      String   // FOLLOW_UP, DEADLINE, OVERDUE, NEW_LEAD, PAYMENT_OVERDUE, MENTION, JOB_RESPONSE
  title     String
  message   String
  linkUrl   String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}
